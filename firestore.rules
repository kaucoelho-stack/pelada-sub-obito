rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Aberto para leitura/escrita — sem login, uso interno com link não-divulgado.
    // Veja o README.md para o contexto e como evoluir isso depois.
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
